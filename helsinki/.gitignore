# Ignore the generated html files from org code
**/*.html

# Org2html cache file
.org2html_cache.json
**/.org2html_cache.json

# Org2pdf cache file
.org2pdf_cache.json
**/.org2pdf_cache.json

# Bazel symlinks and outputs
bazel-*
.bazelrc.user

# Python cache
__pycache__/
*.pyc

# Google Drive credentials
.google_drive_token*
**/.google_drive_token*

# TeX export and compiled PDF files
*.tex
*.pdf
**/*.tex
**/*.pdf

# TeX auxiliary build files
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
**/*.aux
**/*.log
**/*.out
**/*.toc
**/*.fls
**/*.fdb_latexmk
**/*.synctex.gz
