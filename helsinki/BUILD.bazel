load("//:sync.bzl", "sync", "sync_test")
load("//:org2html.bzl", "org2html")
load("//:org2pdf.bzl", "org2pdf")

package(default_visibility = ["//visibility:public"])

# Sync all courses under helsinki
sync(
    name = "sync",
    remote_path = "helsinki",
)

# Compiles Org files to HTML
org2html(
    name = "org2html",
)

# Compiles Org files to PDF
org2pdf(
    name = "org2pdf",
)

sync_test(
    name = "sync_unit_test",
    test_file = "//:test_sync_drive.py",
    data = [
        "//:sync_drive.py",
    ],
)
